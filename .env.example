# Copy to apps/web/.env.local and apps/admin/.env.local for local dev (both gitignored).
DATABASE_URL=postgres://toolfoam:toolfoam@localhost:5432/toolfoam
# Public URL of the landing site — used for the QR code target and links from the admin
NEXT_PUBLIC_WEB_URL=http://localhost:3001
# Admin only. Leave ADMIN_PASSWORD empty in local dev to skip the login wall.
ADMIN_PASSWORD=
SESSION_SECRET=change-me
# Admin only: the foam-workflow API (Flask backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
